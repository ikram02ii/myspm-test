{
  "name": "@workspace/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx ./src/index.ts",
    "build": "npm run typecheck && tsx ./build.ts",
    "start": "node ./dist/index.mjs",

    "typecheck": "npm run typecheck:libs && tsc -p tsconfig.json --noEmit",
    "typecheck:libs": "tsc -b tsconfig.workspace.json",

    "test:marking": "tsx ./scripts/marking/runAll.ts",
    "test:marking:contracts": "tsx ./scripts/marking/subjectContracts.test.ts",
    "test:marking:policy": "tsx ./scripts/marking/calculationPolicy.test.ts",

    "ingest:textbook": "tsx ./scripts/ingestTextbook.ts",
    "ingest:past-paper": "tsx ./scripts/ingestPastPaper.ts",
    "ingest:past-paper-vision": "tsx ./scripts/ingestPastPaperVision.ts",
    "ingest:past-paper-qa": "tsx ./scripts/ingestPastPaperQa.ts",
    "ingest:pdf-hybrid": "tsx ./scripts/ingestPdfHybrid.ts",
    "classify:pdf-pages": "tsx ./scripts/classifyPdfPages.ts",
    "extract:pdf-text": "tsx ./scripts/extractPastPaperPdfText.ts",

    "test:physics-f4-ch1-theory": "tsx ./scripts/runPhysicsF4Ch1TheoryBenchmark.ts",
    "test:physics-f4-ch1-theory:dry": "tsx ./scripts/runPhysicsF4Ch1TheoryBenchmark.ts --dry",
    "test:physics-f4-ch1-theory:smoke": "tsx ./scripts/runPhysicsF4Ch1TheoryBenchmark.ts --limit 3",
    "test:physics-f4-ch1-calc-ma": "tsx ./scripts/runPhysicsF4Ch1CalcModelAnswerBenchmark.ts",
    "test:physics-f4-ch1-calc-ma:dry": "tsx ./scripts/runPhysicsF4Ch1CalcModelAnswerBenchmark.ts --dry",
    "test:physics-f4-ch1-calc-ma:smoke": "tsx ./scripts/runPhysicsF4Ch1CalcModelAnswerBenchmark.ts --limit 3"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "ali-oss": "^6.23.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "express": "^5",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.3",
    "microsoft-cognitiveservices-speech-sdk": "^1.50.0",
    "multer": "^2.1.1",
    "openai": "^6.48.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.18.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.27.3",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@esbuild-kit/esm-loader": "npm:tsx@^4.21.0",
    "pdf-parse": {
      "pdfjs-dist": "5.7.284"
    }
  }
}
