# Copy to .env and fill in values.

# Database (centralised example — URL-encode special chars in password, e.g. ! → %21)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/DATABASE_NAME
DATABASE_URL=
RAG_DATABASE_URL=
# Postgres schema for rag_* tables (default: rag)
RAG_DB_SCHEMA=rag
# Optional override; default is "<RAG_DB_SCHEMA>, public"
# RAG_DB_SEARCH_PATH=rag, public

PORT=3000
NODE_ENV=development
JWT_SECRET=

# Speech-to-text (oral practice) — /api/stt/*
# Qwen falls back to QWEN_GRADING_API_KEY or ALIBABA_LLM_API_KEY if QWEN_API_KEY is unset
QWEN_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-transcribe
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# Optional: disable JWT on STT routes (defaults to same as DISABLE_RAG_AUTH)
# DISABLE_STT_AUTH=true
